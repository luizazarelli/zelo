{
    "compilerOptions": {
        "target": "es2022",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "baseUrl": ".",
        "paths": {
            "@application/*": ["./src/app/*"],
            "@domain/*": ["./src/domain/*"],
            "@infra/*": ["./src/infra/*"],
            "@presentation/*": ["./src/presentation/*"],
            "@common/*": ["./src/common/*"],
            "@test/*": ["./tst/*"]
        },
        "outDir": "./dist",
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "strict": true,
        "skipLibCheck": true
    }
}
